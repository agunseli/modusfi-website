---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy" description="ModusFi website privacy information.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Legal</div>
      <h1>Privacy</h1>
      <p>Privacy information will be published before the website goes live.</p>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:850px">
      <h2 class="heading">Pre-launch placeholder</h2>
      <p class="lead">
        This page is intentionally incomplete. A final privacy notice must identify the legal data
        controller, contact details, purposes of processing, processors, retention periods and
        visitors' rights before collecting personal data.
      </p>
    </div>
  </section>
</BaseLayout>
