---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Experience"
  description="Explore the financial technology and engineering experience behind ModusFi."
>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Experience & track record</div>
      <h1>Built on experience. Driven by engineering.</h1>
      <p>
        Our founding team brings technology leadership, financial services expertise and hands-on
        engineering experience from complex platforms and ventures.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container simple-grid">
      <article class="content-card">
        <div class="eyebrow">Founding-team experience</div>
        <h2 class="heading" style="font-size:32px">
          Open Banking at scale
        </h2>
        <p class="lead">
          Our founding team includes technology leadership experience at Ecospend, a UK Open Banking
          fintech subsequently acquired by Trustly.
        </p>
      </article>
      <article class="content-card">
        <div class="eyebrow">Domain experience</div>
        <h2 class="heading" style="font-size:32px">
          Banking & enterprise systems
        </h2>
        <p class="lead">
          Experience across financial technology, banking systems and enterprise integration informs
          how we approach complex software delivery.
        </p>
      </article>
    </div>
    <p class="container muted" style="margin-top:28px;font-size:13px">
      The experience described here relates to the backgrounds of ModusFi's team members and should
      not be interpreted as projects delivered by ModusFi itself.
    </p>
  </section>
</BaseLayout>
