---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { services } from '../../data/services';

const capabilities = [
  {
    title: 'AI agents and frameworks',
    introduction:
      'Develop agents that use information, tools and business systems to carry out defined tasks.',
    items: [
      'Agent frameworks and multi-step orchestration.',
      'Tool use and integration with enterprise APIs.',
      'Task boundaries, permissions and approval points.',
      'Coordination between agents, deterministic processes and people.',
      'Evaluation, traceability and operational monitoring.',
    ],
  },
  {
    title: 'Intelligent workflows',
    introduction:
      'Combine AI with structured processes to support work that involves interpreting information and exercising judgement.',
    items: [
      'Document analysis and structured information extraction.',
      'Research, investigation and assessment workflows.',
      'Classification, summarisation and information routing.',
      'Business rules, exception handling and human review.',
      'Integration with existing applications and operational processes.',
    ],
  },
  {
    title: 'Knowledge and decision support',
    introduction:
      'Connect AI systems to relevant organisational knowledge, helping people find, assess and use information.',
    items: [
      'Retrieval-Augmented Generation and knowledge integration.',
      'Search and analysis across documents and data sources.',
      'Evidence-linked responses and source references.',
      'Context-aware assistance within business applications.',
      'Decision support with clear human accountability.',
    ],
  },
];

const principles = [
  ['Grounded outputs', 'Connecting responses to relevant information and checking their quality.'],
  ['Controlled actions', 'Defining what a system can access, change or initiate.'],
  ['Human oversight', 'Placing review and approval where the consequences require it.'],
  [
    'Operational reliability',
    'Monitoring behaviour, handling failures and adapting as models and requirements change.',
  ],
];
---

<ServiceLayout
  service={services.ai}
  summary="We combine applied research with software engineering to turn emerging AI capabilities into reliable solutions."
>
  <section slot="introduction" class="section">
    <div class="container grid-two ai-introduction">
      <h2 class="heading">
        Applied research.
        <br />
        Intelligent engineering.
      </h2>
      <p class="lead">
        Our approach considers AI from the outset—alongside data, business rules, system integration
        and human oversight—to improve how organisations analyse information, make decisions and
        operate.
      </p>
    </div>
  </section>

  <section class="section expertise">
    <div class="container">
      <div class="ai-section-introduction">
        <div class="eyebrow">Our capabilities</div>
        <h2 class="heading">From AI capability to working systems</h2>
        <p class="lead">
          Useful AI requires more than a model. It needs relevant information, clear objectives,
          appropriate controls and integration with the systems people already use.
        </p>
        <p class="lead">
          We help organisations explore what is possible, establish what works and engineer it into
          their products and operations.
        </p>
      </div>
      <div class="ai-capability-grid">
        {capabilities.map((capability) => (
          <article class="content-card ai-capability-card">
            <h3>{capability.title}</h3>
            <p>{capability.introduction}</p>
            <ul>
              {capability.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-two ai-engineering">
        <h2 class="heading">AI-native, with engineering discipline</h2>
        <div>
          <p class="lead">
            We design around the strengths and limitations of AI, rather than treating it as an
            isolated feature.
          </p>
          <p class="lead">
            That means deciding where models add value, where conventional software is more
            dependable and where people should remain in control. Architecture, security, evaluation
            and maintainability are part of the design from the beginning.
          </p>
        </div>
      </div>
      <dl class="ai-principles">
        {principles.map(([title, description]) => (
          <div>
            <dt>{title}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section ai-delivery-section">
    <div class="container grid-two ai-delivery">
      <h2 class="heading">Explore, evaluate, engineer</h2>
      <div>
        <p class="lead">
          We start with the business problem and the information available. Focused experiments help
          test feasibility and expose limitations before committing to a wider implementation.
        </p>
        <p class="lead">
          We then develop the solution through iterative evaluation, integration and deployment,
          with ongoing support and improvement as it moves into use.
        </p>
      </div>
    </div>
  </section>

  <section slot="call-to-action" class="section cta">
    <div class="container grid-two ai-cta">
      <h2 class="heading">Discuss your AI initiative</h2>
      <div>
        <p class="lead">
          Exploring an AI-enabled product, an intelligent workflow or an agent-based system? We can
          help assess the opportunity and build a practical path to delivery.
        </p>
        <div class="ai-actions">
          <a href="/contact" class="btn btn-primary">
            Discuss a project <span aria-hidden="true">→</span>
          </a>
          <a href="/services" class="all-services-link">
            Explore all services <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</ServiceLayout>

<style>
  .ai-introduction,
  .ai-cta {
    align-items: center;
  }
  .ai-introduction .heading,
  .ai-introduction .lead,
  .ai-engineering .heading,
  .ai-delivery .heading,
  .ai-cta .heading {
    margin: 0;
  }
  .ai-engineering,
  .ai-delivery {
    align-items: start;
  }
  .ai-engineering .lead:first-child,
  .ai-delivery .lead:first-child {
    margin-top: 0;
  }
  .ai-engineering .lead:last-child,
  .ai-delivery .lead:last-child {
    margin-bottom: 0;
  }
  .ai-section-introduction {
    max-width: 850px;
  }
  .ai-section-introduction .heading {
    margin: 14px 0 18px;
  }
  .lead + .lead {
    margin-top: 18px;
  }
  .ai-capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 36px;
  }
  .ai-capability-card {
    padding: 28px;
    color: #43566b;
    font-size: 16px;
    line-height: 1.75;
  }
  .ai-capability-card h3 {
    margin: 0 0 16px;
    color: #101d32;
    font-family: 'Manrope', sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.4;
  }
  .ai-capability-card p {
    margin: 0;
  }
  .ai-capability-card ul {
    list-style: disc;
    padding-left: 20px;
    margin: 20px 0 0;
  }
  .ai-capability-card li + li {
    margin-top: 10px;
  }
  .ai-principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 42px;
    margin: 36px 0 0;
  }
  .ai-principles > div {
    border-top: 1px solid #cddde8;
    padding-top: 20px;
  }
  .ai-principles dt {
    color: #101d32;
    font-family: 'Manrope', sans-serif;
    font-size: 18px;
    font-weight: 600;
  }
  .ai-principles dd {
    margin: 8px 0 0;
    color: #43566b;
    font-size: 16px;
    line-height: 1.75;
  }
  .ai-delivery-section {
    background: #f3f8fb;
  }
  .ai-cta .lead {
    color: #d9e8f1;
    margin: 0 0 24px;
  }
  .ai-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }
  .all-services-link {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ai-actions a:focus-visible {
    outline: 2px solid #00b3c6;
    outline-offset: 4px;
  }
  @media (max-width: 900px) {
    .ai-capability-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 680px) {
    .ai-principles {
      grid-template-columns: 1fr;
    }
  }
</style>
