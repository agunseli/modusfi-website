---
import ServiceIcon from '../components/ServiceIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { overviewServices } from '../data/services';
---

<BaseLayout
  title="Services"
  description="Explore ModusFi software engineering, AI, cloud modernisation and financial technology services."
>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Our services</div>
      <h1>From strategy to working software.</h1>
      <p>
        We help organisations turn complex technology requirements into secure, scalable and
        maintainable solutions.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container simple-grid">
      {overviewServices.map((s, i) => (
        <article class="content-card service-overview-card">
          <div class="service-overview-label">
            <div class="eyebrow">0{i + 1} / Service</div>
            <ServiceIcon name={s.icon} size={32} />
          </div>
          <h2 class="heading" style="font-size:29px;margin:20px 0">
            {s.title}
          </h2>
          <p class="lead">{s.description}</p>
          <p class="muted" style="font-size:14px;line-height:1.8;margin-top:25px">
            {s.capabilities.join(' · ')}
          </p>
          <a class="text-link service-detail-link" href={`/services/${s.slug}`}>
            Explore this service <span class="sr-only">: {s.title}</span>{' '}
            <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>
  <section class="section" style="background:#edf5fa">
    <div class="container grid-two">
      <div>
        <div class="eyebrow">Technology advisory</div>
        <h2 class="heading">Practical guidance, hands-on expertise.</h2>
      </div>
      <div>
        <p class="lead">
          Architecture reviews, technical discovery, engineering leadership and delivery planning
          grounded in real implementation experience.
        </p>
        <a href="/contact" class="btn btn-dark">
          Discuss a project →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-overview-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--text-turquoise);
  }
  .service-overview-card {
    display: flex;
    flex-direction: column;
  }
  .service-detail-link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: 24px;
    color: #101d32;
  }
  .service-detail-link:focus-visible {
    outline: 2px solid #00b3c6;
    outline-offset: 4px;
  }
</style>
