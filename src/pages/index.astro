---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeServices } from '../data/services';

const icons = {
  code: 'M5 8 1 12l4 4M19 8l4 4-4 4M14 4l-4 16',
  ai: 'M12 3v18M3 12h18M6 6l12 12M18 6 6 18',
  cloud: 'M7 18h12a4 4 0 0 0 .3-8A7 7 0 0 0 6 9a4.5 4.5 0 0 0 1 9h6',
  bank: 'M3 10h18M5 10v10M10 10v10M15 10v10M20 10v10M2 21h20M2 9l10-6 10 6',
};
---

<BaseLayout
  title="Technology Engineering, Financial Services & AI"
  description="ModusFi designs, builds and modernises sophisticated software platforms, combining deep engineering expertise with financial services experience and applied AI."
>
  <!-- Hero -->
  <section class="hero">
    <img class="hero-wave" src="/images/wave.svg" alt="" aria-hidden="true" />

    <div class="container hero-inner">
      <div class="eyebrow" style="color:#20d5e2">
        Technology engineering · Financial services · AI
      </div>

      <h1>
        Complex challenges.
        <br />
        Intelligent engineering.
      </h1>

      <p>
        We design, build and modernise sophisticated software platforms, combining deep engineering
        expertise with proven financial services experience and applied AI.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="/services">
          Explore our services <span aria-hidden="true">→</span>
        </a>

        <a class="btn btn-outline" href="/contact">
          Get in touch
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="grid-two" style="align-items:end;margin-bottom:32px">
        <div>
          <div class="eyebrow">Our services</div>

          <h2 class="heading" style="margin:14px 0 0">
            How we help
          </h2>
        </div>

        <p class="lead" style="margin:0">
          Technology engineering services that turn complex challenges into secure, reliable and
          scalable solutions.
        </p>
      </div>

      <div class="grid-four">
        {homeServices.map((s) => (
          <a
            href={`/services/${s.slug}`}
            class="card service-card"
            aria-label={`Learn about ${s.title}`}
          >
            <svg
              width="42"
              height="42"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[s.icon]} />
            </svg>

            <h3>{s.title}</h3>

            <p>{s.summary}</p>

            <span class="service-card-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="section expertise">
    <div class="container grid-two" style="align-items:center">
      <img
        class="expertise-image"
        src="/images/modusfi-financial-district.webp"
        alt="Modern glass skyscrapers representing financial services and engineering"
        width="1448"
        height="1086"
        loading="lazy"
        decoding="async"
      />

      <div>
        <div class="eyebrow">Our expertise</div>

        <h2 class="heading" style="margin:15px 0 18px">
          Deep financial services expertise.
          <br />
          Broader engineering capability.
        </h2>

        <p class="lead">
          From Open Banking and payments to digital banking and platform modernisation, we combine
          domain knowledge with the engineering capability to deliver secure, reliable and scalable
          solutions.
        </p>

        <ul class="expertise-list" style="padding:0">
          <li>Open Banking & Payments</li>
          <li>Security & Operational Resilience</li>
          <li>Digital Banking & Platforms</li>
          <li>System Integration & APIs</li>
        </ul>

        <a href="/expertise" class="text-link" style="display:inline-block;margin-top:24px">
          Explore our expertise →
        </a>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section">
    <div class="container grid-two" style="align-items:center">
      <div>
        <div class="eyebrow">Our experience</div>

        <h2 class="heading" style="margin:15px 0">
          Built on experience.
          <br />
          Driven by engineering.
        </h2>
      </div>

      <div>
        <p class="lead">
          Our founding team brings experience building and scaling financial technology platforms,
          including technology leadership at Ecospend, an Open Banking company subsequently acquired
          by Trustly.
        </p>

        <a class="text-link" href="/experience">
          Explore our experience →
        </a>
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" style="background:#f3f8fb">
    <div class="container">
      <div class="grid-two" style="align-items:end;margin-bottom:38px">
        <div>
          <div class="eyebrow">Our approach</div>

          <h2 class="heading" style="margin:15px 0 0">
            A pragmatic, end-to-end partnership.
          </h2>
        </div>

        <p class="lead" style="margin:0">
          From initial discovery through delivery and continuous improvement.
        </p>
      </div>

      <div class="process">
        {[
          ['01', 'Discover', 'Understand the challenge and define the opportunity.'],
          ['02', 'Design', 'Shape the right solution and approach.'],
          ['03', 'Build', 'Engineer, test and deliver with quality.'],
          ['04', 'Evolve', 'Support, enhance and scale over time.'],
        ].map((s) => (
          <div class="process-item">
            <div class="process-number">{s[0]}</div>
            <strong>{s[1]}</strong>
            <p>{s[2]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Call to action -->
  <section class="section cta">
    <div class="container grid-two" style="align-items:center">
      <h2 class="heading" style="margin:0">
        Let's build something
        <br />
        that matters.
      </h2>

      <div>
        <p style="font-size:19px;line-height:1.6;color:#d9e8f1;margin:0 0 25px">
          Have a challenge in mind? We'd love to hear from you.
        </p>

        <a href="/contact" class="btn btn-primary">
          Contact us →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
