---
import FounderCard from '../components/FounderCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import alisanPortrait from '../assets/founders/alisan-gunseli.png';
import gerryPortrait from '../assets/founders/gerry-griffin.png';

const founders = [
  { name: 'Alişan Günseli', role: 'Technology Lead', portrait: alisanPortrait, portraitScale: 1 },
  {
    name: 'Gerry Griffin',
    role: 'Customer Relations',
    portrait: gerryPortrait,
    portraitScale: 0.9,
  },
];
---

<BaseLayout
  title="About"
  description="Meet ModusFi’s founders and learn about our engineering philosophy, delivery approach and financial technology experience."
>
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">About ModusFi</div>
      <h1>Engineering with experience. Innovation with purpose.</h1>
      <p>
        Technology is most valuable when it solves a meaningful business challenge reliably,
        securely and sustainably.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container grid-two">
      <div>
        <div class="eyebrow">Our philosophy</div>
        <h2 class="heading">Thoughtful architecture. Hands-on engineering.</h2>
      </div>
      <div>
        <p class="lead">
          ModusFi brings together technology professionals with experience across financial
          technology, enterprise software engineering, digital platforms and applied AI.
        </p>
        <p class="lead">
          We believe successful delivery requires more than choosing the right tools. It requires
          understanding the problem, making sound architectural decisions, and taking responsibility
          for quality, security and long-term maintainability.
        </p>
      </div>
    </div>
  </section>
  <section class="section" style="background:#edf5fa">
    <div class="container">
      <div class="eyebrow">How we work</div>
      <h2 class="heading">A partnership from discovery to delivery.</h2>
      <div class="process" style="margin-top:35px">
        {[
          ['01', 'Understand'],
          ['02', 'Architect'],
          ['03', 'Engineer'],
          ['04', 'Improve'],
        ].map((s) => (
          <div class="process-item">
            <div class="process-number">{s[0]}</div>
            <strong>{s[1]}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section id="founders" class="section founders-section" aria-labelledby="founders-heading">
    <div class="container">
      <div class="founders-introduction">
        <div class="eyebrow">Our founders</div>
        <h2 id="founders-heading" class="heading">
          The people behind ModusFi
        </h2>
      </div>
      <div class="founders-grid">
        {founders.map((founder) => (
          <FounderCard
            name={founder.name}
            role={founder.role}
            portrait={founder.portrait}
            portraitScale={founder.portraitScale}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .founders-section {
    scroll-margin-top: 80px;
  }
  .founders-introduction {
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }
  .founders-introduction .heading {
    margin: 14px 0 0;
  }
  .founders-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    max-width: 780px;
    margin-inline: auto;
  }
  @media (max-width: 680px) {
    .founders-grid {
      grid-template-columns: minmax(0, 340px);
      justify-content: center;
      gap: 36px;
    }
  }
</style>
